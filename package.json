{
  "name": "llm-media-library",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:rust": "cd src-tauri && cargo test --locked",
    "tauri": "tauri",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc --bundles nsis",
    "build:windows:msi": "tauri build --target x86_64-pc-windows-msvc --bundles msi",
    "build:windows:cross": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "version:check": "node scripts/version.mjs check",
    "version:set": "node scripts/version.mjs set"
  },
  "dependencies": {
    "@google/genai": "^2.32.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
